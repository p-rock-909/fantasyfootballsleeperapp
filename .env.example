# Required: your Claude API key (server-side only; never sent to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: protect /api/recommend so a public Vercel URL can't spend your key.
# When set, enter the same value in the app's Settings drawer.
APP_PASSWORD=

# Optional: override the model (default claude-opus-5)
ANTHROPIC_MODEL=
