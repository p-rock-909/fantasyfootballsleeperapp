# Which model evaluates the board: "gemini" (default) or "anthropic".
LLM_PROVIDER=

# Required when LLM_PROVIDER is gemini (the default).
# Server-side only; never sent to the browser.
GEMINI_API_KEY=

# Optional: override the Gemini model (default gemini-pro-latest).
# Effort is sent as a thinking level, which expects a Gemini 3 or newer model.
GEMINI_MODEL=

# Optional: protect /api/recommend so a public Vercel URL can't spend your key.
# When set, enter the same value in the app's Settings drawer.
APP_PASSWORD=

# --- Only read when LLM_PROVIDER=anthropic ---

# Your Claude API key (server-side only; never sent to the browser).
ANTHROPIC_API_KEY=

# Required only if your key is identity-linked (the API then returns
# "anthropic-workspace-id is required"): the workspace the request acts in.
# Console → Settings → Workspaces, or the wrkspc_... id in the workspace URL.
ANTHROPIC_WORKSPACE_ID=

# Optional: override the model (default claude-opus-5)
ANTHROPIC_MODEL=
